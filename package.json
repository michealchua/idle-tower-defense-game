{
  "name": "tatakai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/michealchua/idle-tower-defense-game.git"
  },
  "packageManager": "traversal@1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs http://localhost:4728",
    "electron:build": "npm run build && electron-builder",
    "build:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.michealchua.tatakai",
    "productName": "tataKAI",
    "directories": {
      "app": "electron",
      "output": "release",
      "buildResources": "build"
    },
    "icon": "build/icon.png",
    "extraResources": [
      {
        "from": "dist",
        "to": "dist"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "michealchua",
      "repo": "idle-tower-defense-game",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "tataKAI"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
