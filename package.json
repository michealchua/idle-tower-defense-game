{
  "name": "idle-tower-defense",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "traversal@1.0.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "electron:dev": "electron electron/main.cjs http://localhost:4728",
    "electron:build": "electron-builder"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  },
  "build": {
    "appId": "com.michealchua.idletowerdefense",
    "productName": "tataKAI",
    "directories": {
      "app": "electron",
      "output": "release"
    },
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "electron-winstaller@5.4.0": true
  }
}
